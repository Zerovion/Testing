# Port the backend listens on (most hosts like Render/Railway set this for you)
PORT=3000

# Secret used to sign JWT auth tokens — set a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# The deployed URL of your frontend (the "bridge"), e.g. https://your-app.vercel.app
# Restricts CORS so only your frontend can call this API. Leave unset locally.
FRONTEND_ORIGIN=
